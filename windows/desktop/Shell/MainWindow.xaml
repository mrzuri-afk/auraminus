<Window x:Class="Auraminus.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Auraminus — Sound, in good company." Icon="/Resources/app.ico"
 Width="1020" Height="760" MinWidth="850" MinHeight="640"
 WindowStartupLocation="CenterScreen" Background="#101919" Foreground="#EDF5EF"
 FontFamily="Segoe UI" Loaded="OnWindowLoaded">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#253B36"/><Setter Property="Foreground" Value="#EDF5EF"/>
   <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF5EF"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#162321" Padding="24,30">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="a∿" FontSize="44" Foreground="#A6E5B9" FontWeight="Bold"/>
     <TextBlock Text="auraminus" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
     <TextBlock Text="YOUR DESKTOP, AMPLIFIED" FontSize="9" Foreground="#91A89D" Margin="0,8,0,38"/>
     <Border Background="#294039" CornerRadius="8" Padding="14,12"><TextBlock Text="◉   Audio studio" Foreground="#BBEDC9"/></Border>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="LOCAL AUDIO. SHARED SPACE." FontSize="9" Foreground="#91A89D" Margin="0,20,0,12"/>
     <TextBlock Text="System sound, routed to the speakers you choose." TextWrapping="Wrap" Foreground="#91A89D" FontSize="12" LineHeight="20"/>
     <TextBlock Text="WINDOWS · WASAPI" FontSize="10" Foreground="#5E7E70" Margin="0,22,0,0"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="THE LISTENING ROOM" Foreground="#A6E5B9" FontSize="10" FontWeight="SemiBold"/>
    <TextBlock Text="One source. More connection." FontSize="28" FontWeight="SemiBold" Margin="0,9,0,8"/>
    <TextBlock Text="Choose your outputs. Shape the mix. Bring the room together." Foreground="#91A89D" TextWrapping="Wrap"/>
   </StackPanel>
   <Border Grid.Row="1" Background="#1C2D28" CornerRadius="12" Padding="20" Margin="0,24,0,22">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="SESSION" Foreground="#91A89D" FontSize="10"/>
      <TextBlock Name="StatusText" Text="Discovering playback devices…" TextWrapping="Wrap" Margin="0,7,12,0" FontSize="14"/>
      <TextBlock Name="SelectionText" Foreground="#A6E5B9" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel>
     <Button Grid.Column="1" Name="ActionBtn" Click="OnActionClick" Background="#A6E5B9" Foreground="#10251C" VerticalAlignment="Center" MinWidth="130">
      <TextBlock Name="ActionBtnText" Text="Start session" FontWeight="SemiBold"/>
     </Button>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Output devices" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="The Windows source plays directly; adjust secondary outputs below." Foreground="#91A89D" FontSize="11" Margin="0,6,10,0" TextWrapping="Wrap"/></StackPanel>
    <Button Grid.Column="1" Name="RefreshBtn" Content="↻  Scan" Click="OnRefreshClick" VerticalAlignment="Center"/>
   </Grid>
   <Grid Grid.Row="3">
    <TextBlock Name="EmptyText" Text="No playback devices found. Connect a speaker, then scan again." Foreground="#91A89D" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="25"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl Name="DevicesList"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#182622" BorderBrush="#2B4037" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
       <StackPanel>
        <CheckBox IsChecked="{Binding IsSelected}" Click="OnDeviceSelectionChanged" AutomationProperties.Name="{Binding Name}">
         <StackPanel Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Role}" FontSize="9" Foreground="#91A89D" Margin="0,4,0,0"/></StackPanel>
        </CheckBox>
        <Grid Margin="24,17,0,0" IsEnabled="{Binding CanAdjust}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><DockPanel><TextBlock Text="Volume" Foreground="#91A89D" FontSize="11"/><TextBlock Text="{Binding VolumePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="11"/></DockPanel><Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}" ValueChanged="OnVolumeChanged" AutomationProperties.Name="Output volume"/></StackPanel>
         <StackPanel Grid.Column="2"><DockPanel><TextBlock Text="Alignment delay" Foreground="#91A89D" FontSize="11"/><TextBlock Text="{Binding DelayMs, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" FontSize="11"/></DockPanel><Slider Minimum="0" Maximum="500" Value="{Binding DelayMs}" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnDelayChanged" AutomationProperties.Name="Output delay in milliseconds"/></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </Grid>
   <StackPanel Grid.Row="4" Margin="0,12,0,0">
    <DockPanel><Button DockPanel.Dock="Right" Content="Save mix" Click="OnSaveClick" Padding="14,7"/><TextBlock Name="TelemetryText" Text="Ready when you are." Foreground="#91A89D" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/></DockPanel>
    <TextBlock Text="Closing this window keeps your session in the system tray." FontSize="10" Foreground="#5E7E70" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
