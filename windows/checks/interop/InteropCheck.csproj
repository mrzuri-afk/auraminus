<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\desktop\Audio\Interop\*.cs" />
    <Compile Include="..\..\desktop\Audio\Models\*.cs" />
    <Compile Include="..\..\desktop\Audio\Services\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\output\native\bin\AuraminusEngine.dll"
          Condition="Exists('..\..\output\native\bin\AuraminusEngine.dll')"
          CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
